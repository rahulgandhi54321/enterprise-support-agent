# AI provider — "openai" or "cohere" (default: openai)
AI_PROVIDER=openai

# OpenAI — used when AI_PROVIDER=openai
OPENAI_API_KEY=
SUPPORT_AGENT_MODEL_FALLBACKS=gpt-4.1-mini,gpt-4o-mini

# Cohere — used when AI_PROVIDER=cohere
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Thresholds
REFUND_APPROVAL_THRESHOLD=100
CONFIDENCE_THRESHOLD=0.75
